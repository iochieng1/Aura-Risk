# development or production. Production refuses to start with missing
# secrets or the placeholder values below.
APP_ENV=development
PORT=8080

# Local Postgres (docker compose up -d postgres). Pick your own password.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=aurarisk
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?sslmode=disable

# Photo attachments (docker compose up -d objectstore objectstore-init clamav)
S3_BUCKET=aurarisk-photos
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
# Must be reachable from phones; use your machine's LAN IP when testing on a device.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=aurarisk
AWS_SECRET_ACCESS_KEY=change-me-local-objectstore-secret
CLAMD_ADDR=localhost:3310

# Prometheus metrics listener (separate from PORT; never expose it publicly).
# ":9464" lets the local monitoring stack scrape it from Docker; the default
# when unset is localhost:9464, and an empty value disables it.
METRICS_ADDR=:9464
# Database pool size per backend instance. Keep instances x DB_MAX_OPEN_CONNS
# below Postgres max_connections (100 by default).
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# Push notifications
NOTIFIER_INTERVAL=15m
# Required in production while the notifier is enabled.
EXPO_ACCESS_TOKEN=

# Any secret above (DATABASE_URL, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# EXPO_ACCESS_TOKEN) can instead be provided as:
#   DATABASE_URL_FILE=/run/secrets/database_url        (mounted secret file)
#   DATABASE_URL=awssm://prod/aurarisk#database_url    (AWS Secrets Manager)
