# development or production. Production refuses to start with missing
# secrets or the placeholder values below.
APP_ENV=development
PORT=8080

# Local Postgres (docker compose up -d postgres). Pick your own password.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=aurarisk
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?sslmode=disable

# Photo attachments (docker compose up -d objectstore objectstore-init clamav)
S3_BUCKET=aurarisk-photos
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
# Must be reachable from phones; use your machine's LAN IP when testing on a device.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=aurarisk
AWS_SECRET_ACCESS_KEY=change-me-local-objectstore-secret
CLAMD_ADDR=localhost:3310

# Browser origins allowed to call the API (comma-separated, scheme://host[:port]).
# Defaults to the Vite dev server. Leave empty when the web app and API share
# an origin behind one reverse proxy; "*" is refused.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Prometheus metrics listener (separate from PORT; never expose it publicly).
# ":9464" lets the local monitoring stack scrape it from Docker; the default
# when unset is localhost:9464, and an empty value disables it.
METRICS_ADDR=:9464
# Database pool size per backend instance. Keep instances x DB_MAX_OPEN_CONNS
# below Postgres max_connections (100 by default).
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# Weather (Open-Meteo). The free API is for non-commercial use only; set
# OPEN_METEO_API_KEY for a paid plan (uses customer-api.open-meteo.com).
OPEN_METEO_API_KEY=
# Lookups are cached per ~2 km grid cell for WEATHER_CACHE_TTL. While Open-Meteo
# is failing, cached data up to WEATHER_STALE_MAX old is served marked stale
# (0 disables that). Outgoing calls are capped per instance; the free API
# allows 600/minute across all instances.
WEATHER_CACHE_TTL=15m
WEATHER_STALE_MAX=3h
WEATHER_MAX_REQUESTS_PER_MINUTE=300

# Push notifications
NOTIFIER_INTERVAL=15m
# Required in production while the notifier is enabled.
EXPO_ACCESS_TOKEN=

# Report moderation (see docs/REPORT_CURATION.md). Comma-separated
# "name:token" pairs; names appear in the audit trail. Empty disables the
# moderation API. Production requires tokens of 32+ characters, e.g.
#   MODERATOR_TOKENS=alice:$(openssl rand -hex 32)
MODERATOR_TOKENS=
# Automatic verification and retention cleanup. 0 disables a worker.
REPORT_VERIFIER_INTERVAL=2m
RETENTION_INTERVAL=1h
# Retention in days (0 keeps that data forever).
RETENTION_REJECTED_DAYS=30
RETENTION_DUPLICATE_DAYS=30
RETENTION_PENDING_DAYS=180
RETENTION_VERIFIED_DAYS=730
RETENTION_FAILED_PHOTO_DAYS=30

# Any secret above (DATABASE_URL, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# EXPO_ACCESS_TOKEN, MODERATOR_TOKENS, OPEN_METEO_API_KEY) can instead be provided as:
#   DATABASE_URL_FILE=/run/secrets/database_url        (mounted secret file)
#   DATABASE_URL=awssm://prod/aurarisk#database_url    (AWS Secrets Manager)
