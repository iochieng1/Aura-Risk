# development or production. Production refuses to start with missing
# secrets or the placeholder values below.
APP_ENV=development
PORT=8080

# Local Postgres (docker compose up -d postgres). Pick your own password.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=aurarisk
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?sslmode=disable

# Photo attachments (docker compose up -d objectstore objectstore-init clamav)
S3_BUCKET=aurarisk-photos
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
# Must be reachable from phones; use your machine's LAN IP when testing on a device.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=aurarisk
AWS_SECRET_ACCESS_KEY=change-me-local-objectstore-secret
CLAMD_ADDR=localhost:3310

# Browser origins allowed to call the API (comma-separated, scheme://host[:port]).
# Defaults to the Vite dev server. Leave empty when the web app and API share
# an origin behind one reverse proxy; "*" is refused.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Behind a reverse proxy / load balancer, list its addresses or CIDRs here
# (comma-separated) so the real client IP is read from X-Forwarded-For. Empty
# trusts no proxy: correct when clients connect directly, but behind a proxy
# every client would share one IP and one rate limit.
TRUSTED_PROXIES=
# Per-client-IP requests per minute, per instance (0 disables). Report,
# device-registration and photo-upload creation also count against the writes limit.
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_WRITES_PER_MINUTE=20
# Schema migrations are a deployment step (`go run . migrate`); the server
# refuses to start while any are pending. true applies them at startup
# instead, for local development only.
AUTO_MIGRATE=false
# On SIGTERM: fail /health/ready for SHUTDOWN_DRAIN_DELAY (set it above the load
# balancer's health-check interval in production), then finish in-flight
# requests and background work within SHUTDOWN_TIMEOUT.
SHUTDOWN_DRAIN_DELAY=0
SHUTDOWN_TIMEOUT=20s

# Prometheus metrics listener (separate from PORT; never expose it publicly).
# ":9464" lets the local monitoring stack scrape it from Docker; the default
# when unset is localhost:9464, and an empty value disables it.
METRICS_ADDR=:9464
# Logs: "text" (development default) or "json" (production default). With
# LOG_FILE set, logs are also appended to that file, which the local monitoring
# stack's Alloy tails and ships to Loki (path relative to aurarisk-backend/).
LOG_FORMAT=json
LOG_FILE=../logs/backend.log
# Database pool size per backend instance. Keep instances x DB_MAX_OPEN_CONNS
# below Postgres max_connections (100 by default).
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
# Seconds to wait for a new database connection (added to DATABASE_URL unless
# it sets connect_timeout), and the deadline for each /api request. When the
# database is down or too slow, requests answer 503 with Retry-After.
DB_CONNECT_TIMEOUT=5
REQUEST_TIMEOUT=25s

# Weather (Open-Meteo). The free API is for non-commercial use only; set
# OPEN_METEO_API_KEY for a paid plan (uses customer-api.open-meteo.com).
OPEN_METEO_API_KEY=
# Lookups are cached per ~2 km grid cell for WEATHER_CACHE_TTL. While Open-Meteo
# is failing, cached data up to WEATHER_STALE_MAX old is served marked stale
# (0 disables that). Outgoing calls are capped per instance; the free API
# allows 600/minute across all instances.
WEATHER_CACHE_TTL=15m
WEATHER_STALE_MAX=3h
WEATHER_MAX_REQUESTS_PER_MINUTE=300
# Ground elevation and GloFAS river discharge for the score come from
# Open-Meteo's Elevation and Flood APIs, chosen like the forecast URL. Set
# these only for a self-hosted Open-Meteo.
OPEN_METEO_ELEVATION_URL=
OPEN_METEO_FLOOD_URL=

# Push notifications
NOTIFIER_INTERVAL=15m
# Required in production while the notifier is enabled.
EXPO_ACCESS_TOKEN=

# Report moderation (see docs/REPORT_CURATION.md). Comma-separated
# "name:token" pairs; names appear in the audit trail. Empty disables the
# moderation API. Production requires tokens of 32+ characters, e.g.
#   MODERATOR_TOKENS=alice:$(openssl rand -hex 32)
MODERATOR_TOKENS=
# County responders (see docs/COUNTY_RESPONSE.md): "name:County:token" pairs.
# Each responder acknowledges and resolves verified reports in their county.
RESPONDER_TOKENS=
# Webhook per county, called when a report there is verified:
# "County=https://...,County=https://...". Signed with the secret below.
COUNTY_WEBHOOKS=
COUNTY_WEBHOOK_SECRET=

# SMS and USSD through Africa's Talking (see docs/SMS_USSD.md). Setting
# CHANNEL_CALLBACK_SECRET enables /api/channels/{sms,ussd}; it must match the
# callback URLs' ?key=. Phone numbers are stored only as an HMAC with the salt.
CHANNEL_CALLBACK_SECRET=
CHANNEL_PHONE_SALT=
CHANNEL_RATE_LIMIT_PER_MINUTE=10
CHANNEL_REPORTS_PER_HOUR=5
# For SMS replies; without them replies are logged. AT_SANDBOX=true for testing.
AT_USERNAME=
AT_API_KEY=
AT_SMS_FROM=
AT_SANDBOX=false
# Automatic verification and retention cleanup. 0 disables a worker.
REPORT_VERIFIER_INTERVAL=2m
RETENTION_INTERVAL=1h
# Retention in days (0 keeps that data forever).
RETENTION_REJECTED_DAYS=30
RETENTION_DUPLICATE_DAYS=30
RETENTION_PENDING_DAYS=180
RETENTION_VERIFIED_DAYS=730
RETENTION_FAILED_PHOTO_DAYS=30

# Any secret above (DATABASE_URL, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# EXPO_ACCESS_TOKEN, MODERATOR_TOKENS, RESPONDER_TOKENS, COUNTY_WEBHOOK_SECRET,
# CHANNEL_CALLBACK_SECRET, CHANNEL_PHONE_SALT, AT_API_KEY, OPEN_METEO_API_KEY)
# can instead be provided as:
#   DATABASE_URL_FILE=/run/secrets/database_url        (mounted secret file)
#   DATABASE_URL=awssm://prod/aurarisk#database_url    (AWS Secrets Manager)
