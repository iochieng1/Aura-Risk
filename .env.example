PORT=8080
DATABASE_URL=postgres://postgres:password@localhost:5432/aurarisk?sslmode=disable

# Photo attachments (docker compose up -d objectstore objectstore-init clamav)
S3_BUCKET=aurarisk-photos
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
# Must be reachable from phones; use your machine's LAN IP when testing on a device.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=aurarisk
AWS_SECRET_ACCESS_KEY=aurarisk-dev-secret
CLAMD_ADDR=localhost:3310

# Push notifications
NOTIFIER_INTERVAL=15m
EXPO_ACCESS_TOKEN=
