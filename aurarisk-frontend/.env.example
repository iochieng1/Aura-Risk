# Copy to .env.local for local overrides. VITE_* values are compiled into the
# bundle at build time, so never put secrets in them.

# Backend origin. Leave empty to call /api on the same origin: in development
# the Vite server proxies it (see API_PROXY_TARGET), in production put the app
# and the API behind one reverse proxy. Set it when the API is on another
# origin, and add this app's origin to the backend's CORS_ALLOWED_ORIGINS.
VITE_API_BASE_URL=

# Where `npm run dev` proxies /api. Not included in the bundle.
API_PROXY_TARGET=http://localhost:8080

# "true" shows mock data instead of calling the backend, for UI work without
# one. Ignored by production builds.
VITE_USE_MOCK_API=false
