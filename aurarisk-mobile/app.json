{
  "expo": {
    "name": "aurarisk-mobile",
    "slug": "aurarisk-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#0b5cad",
          "defaultChannel": "risk-alerts",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AuraRisk uses your photo library only when you choose a photo to attach to a flood report. Location data in the photo is removed before upload.",
          "cameraPermission": "AuraRisk uses the camera only when you take a photo to attach to a flood report.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AuraRisk uses your location only when you tap \"Use my location\" to check flood risk or place a report. You can always search or enter coordinates instead."
        }
      ]
    ]
  }
}
