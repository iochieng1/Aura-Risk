# Production settings for deploy/docker-compose.prod.yml. Copy to
# production.env (git-ignored) and fill in. config.Validate refuses to start
# with missing or development secrets when APP_ENV=production.

# Hosts Caddy serves and gets certificates for (DNS must point here first).
API_HOST=api.aurarisk.example
WEB_HOST=aurarisk.example
ACME_EMAIL=ops@aurarisk.example

# Managed Postgres with PostGIS, TLS required.
DATABASE_URL=postgres://aurarisk:CHANGE_ME@db.example:5432/aurarisk?sslmode=require
CORS_ALLOWED_ORIGINS=https://aurarisk.example
# Above Caddy's health-check interval (10s), so it stops routing first.
SHUTDOWN_DRAIN_DELAY=15s
LOG_FORMAT=json

# Paid Open-Meteo key: the free API is non-commercial only (#69).
OPEN_METEO_API_KEY=
EXPO_ACCESS_TOKEN=
MODERATOR_TOKENS=
RESPONDER_TOKENS=
COUNTY_WEBHOOKS=
COUNTY_WEBHOOK_SECRET=

# Photos (S3) and malware scanning; leave S3_BUCKET empty to disable uploads.
S3_BUCKET=
S3_REGION=ap-southeast-1
CLAMD_ADDR=
