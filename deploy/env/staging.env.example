# Staging: the same image and compose file as production, with its own
# database and hosts. Deploy every main build here first, then promote the
# same IMAGE_TAG to production.
#   ENV_FILE=env/staging.env IMAGE_TAG=sha-<commit> docker compose -p aurarisk-staging \
#     -f deploy/docker-compose.prod.yml --env-file deploy/env/staging.env up -d

API_HOST=api.staging.aurarisk.example
WEB_HOST=staging.aurarisk.example
ACME_EMAIL=ops@aurarisk.example

DATABASE_URL=postgres://aurarisk:CHANGE_ME@staging-db.example:5432/aurarisk?sslmode=require
CORS_ALLOWED_ORIGINS=https://staging.aurarisk.example
SHUTDOWN_DRAIN_DELAY=15s
LOG_FORMAT=json
# Staging never sends real push alerts.
NOTIFIER_INTERVAL=0
OPEN_METEO_API_KEY=
MODERATOR_TOKENS=
